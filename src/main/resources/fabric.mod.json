{
  "schemaVersion": 1,
  "id": "gl4esfix",
  "version": "${version}",

  "name": "GL4ES Fix",
  "description": "A mod that switches rendering from triangles to quads to fix gl4es rendering issues in legacy Minecraft versions on mobile launchers",
  "authors": [
    "ItsElix99"
  ],

  "contact": {
    "homepage": "https://github.com/ItsElix99/GL4ES-Fix/",
    "sources": "https://github.com/ItsElix99/GL4ES-Fix/",
    "issues": "https://github.com/ItsElix99/GL4ES-Fix/issues"
  },

  "license": "MIT",
  "icon": "assets/gl4esfix/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "com.itselix99.gl4esfix.GL4ESFix"
    ],
    "stationapi:event_bus": [
    ],
    "stationapi:event_bus_client": [
    ],
    "stationapi:event_bus_server": [
    ]
  },
  "mixins": [
    "gl4esfix.mixins.json"
  ],

  "depends": {
    "minecraft": "1.0.0-beta.7.3"
  }
}
